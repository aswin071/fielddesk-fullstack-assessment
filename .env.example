APP_ENV=development
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173

POSTGRES_DB=fielddesk
POSTGRES_USER=fielddesk
POSTGRES_PASSWORD=fielddesk-development-only
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_EXPOSE_PORT=55432
DATABASE_URL=postgresql://fielddesk:fielddesk-development-only@db:5432/fielddesk

REDIS_URL=redis://redis:6379/0
REDIS_EXPOSE_PORT=56379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_SECURE=false
AUTH_LOGIN_IP_RATE=20/hour
AUTH_LOGIN_IDENTITY_RATE=10/hour
PROGRESS_EVENT_RATE=120/minute
PROGRESS_EVENT_MAX_FUTURE_SECONDS=300
PROGRESS_EVENT_MAX_AGE_DAYS=30
ATTACHMENT_MAX_BYTES=10485760
ORGANISATION_STORAGE_LIMIT_BYTES=104857600
NOTIFICATION_PROVIDER_MODE=success
NOTIFICATION_PROVIDER_TEMPORARY_FAILURES=1
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BASE_SECONDS=2
REALTIME_HEARTBEAT_SECONDS=15
REALTIME_MAX_CONNECTION_SECONDS=600
REPORT_EXPORT_MAX_ROWS=100000
REPORT_EXPORT_CHUNK_SIZE=1000

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_REALTIME_URL=http://localhost:8000/api/v1/realtime/events
